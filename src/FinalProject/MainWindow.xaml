<Window x:Class="FinalProject.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:FinalProject"
        mc:Ignorable="d"
        Title="Construction Manager" Height="550" Width="850"
        Background="WhiteSmoke"
        Closing="Window_Closing">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="30"/>
            <RowDefinition Height="100"/>
            <RowDefinition/>
            <RowDefinition Height="60"/>
            <RowDefinition Height="30"/>
        </Grid.RowDefinitions>

        <!--1 MENU-->
        <Menu Grid.Row="0" Background="DarkGreen">
            <MenuItem Header="File" Background="DarkGreen" Foreground="White">
                <MenuItem Header="Save" Click="MenuSave_Click" Background="DarkGreen"/>
                <MenuItem Header="Load" Click="MenuLoad_Click" Background="DarkGreen"/>
                <MenuItem Header="Exit" Click="MenuExit_Click" Background="DarkGreen"/>
            </MenuItem>
            <MenuItem Header="Help" Background="DarkGreen" Foreground="White">
                <MenuItem Header="About" Click="MenuAbout_Click" Background="DarkGreen"/>
            </MenuItem>
        </Menu>
        <!--2 data about project-->
        <Grid Grid.Row="1" Background="LightGray">
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="Catalog Count"
                           Foreground="DarkGray" FontSize="12"
                           HorizontalAlignment="Center"/>
                <TextBlock Text="{Binding listofmaterials.Count}"
                           Foreground="DarkGreen" FontSize="28" FontWeight="Bold"
                           HorizontalAlignment="Center"/>
                <TextBlock Text="Materials"
                           Foreground="Gray" FontSize="12"
                           HorizontalAlignment="Center"/>
            </StackPanel>

            <StackPanel Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="Orders Count"
                           Foreground="DarkGray" FontSize="12"
                           HorizontalAlignment="Center"/>
                <TextBlock Text="{Binding Listoforders.Count}"
                           Foreground="DarkGreen" FontSize="28" FontWeight="Bold"
                           HorizontalAlignment="Center"/>
                <TextBlock Text="{Binding PendingCount,StringFormat='{}{0} Pending'}"
                           Foreground="Gray" FontSize="12"
                           HorizontalAlignment="Center"/>
            </StackPanel>

            <StackPanel Grid.Column="2" HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="Total Spent"
                           Foreground="DarkGray" FontSize="12"
                           HorizontalAlignment="Center"/>
                <TextBlock Text="{Binding TotalSpentThisMonth, StringFormat='{}{0:N0} EGP'}"
                           Foreground="DarkGreen" FontSize="28" FontWeight="Bold"
                           HorizontalAlignment="Center"/>
                <TextBlock Text="This Month"
                           Foreground="Gray" FontSize="11"
                           HorizontalAlignment="Center"/>
            </StackPanel>
        </Grid>
        <!--3-->
        <Grid Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="40"/>
                <RowDefinition/>
            </Grid.RowDefinitions>
            <!--1-->
            <Grid Grid.Row="0" Background="White">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Material Catalog"
                           Grid.Column="0"
                           FontSize="15" FontWeight="Bold"
                           Foreground="Black"
                           VerticalAlignment="Center"
                           Margin="10"/>
                <Button Content="Delete Material"
                        Grid.Column="1"
                        Width="140" HorizontalAlignment="Right" Margin="3"
                        Click="Delete"/>
                <Button Content="+ Add Material"
                        Grid.Column="2"
                        Width="140" HorizontalAlignment="Right" Margin="3"
                        Click="AddMaterial"/>
            </Grid>
            <!--2-->
            <DataGrid Grid.Row="1"
                      x:Name="materialsatdataGrid"
                      ItemsSource="{Binding listofmaterials}"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      IsReadOnly="True"
                      Background="White"
                      Foreground="Black"                                          
                      GridLinesVisibility="Horizontal"
                      HorizontalGridLinesBrush="LightGray"
                      FontSize="13">
                <DataGrid.ColumnHeaderStyle>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="DarkGreen"/>
                        <Setter Property="Foreground" Value="White"/>
                    </Style>
                </DataGrid.ColumnHeaderStyle>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="2*"/>
                    <DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="2*"/>
                    <DataGridTextColumn Header="Unit" Binding="{Binding Unit}" Width="*"/>
                    <DataGridTextColumn Header="Price/Unit" Binding="{Binding UnitPrice}" Width="*"/>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>
        <!--4  -->
        <Grid Grid.Row="3" Background="LightGray">
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                <Button Content="Open Calculator"
                        Width="150" Margin="10"
                        Click="Open_Calculator"/>
                <Button Content="Open Orders"
                        Width="150" Margin="10"
                        Click="Open_Orders"/>
            </StackPanel>
        </Grid>
        <!--5 -->
        <Grid Grid.Row="4" Background="DarkGreen">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0"
               Text="{Binding LastSaved,StringFormat='Last Saved:{0:dd/MM/yyyy hh:mm tt}'}"
               Foreground="White" FontSize="12"
               VerticalAlignment="Center" Margin="10,0"/>
            
            <TextBlock Grid.Column="1"
               Text="{Binding listofmaterials.Count,StringFormat='Mterials {0}'}"
               Foreground="White" FontSize="12"
               VerticalAlignment="Center" Margin="10"/>

            <TextBlock Grid.Column="3"
               Text="Version 1.0"
               Foreground="White" FontSize="12"
               VerticalAlignment="Center" Margin="10"/>
        </Grid>
    </Grid>
</Window>