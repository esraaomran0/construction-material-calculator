<Window x:Class="FinalProject.Windows.OrdersWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Orders" Height="550" Width="900"
        Background="WhiteSmoke">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="50"/>
            <RowDefinition Height="50"/>
            <RowDefinition/>
            <RowDefinition Height="50"/>
            <RowDefinition Height="60"/>
        </Grid.RowDefinitions>
        <!-- 1 -->
        <TextBlock Grid.Row="0" Text="Orders Management"
                   FontSize="20" FontWeight="Bold"
                   Foreground="DarkGreen"
                   VerticalAlignment="Center" HorizontalAlignment="Left"/>

        <!--2 -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" VerticalAlignment="Center">

            <TextBlock Text="Status:" FontSize="13" Foreground="Black"
                       VerticalAlignment="Center" Margin="0,0,6,0"/>
            <ComboBox x:Name="StatusFilter" Width="110" Margin="0,0,12,0"
                      SelectionChanged="Filter">
                <ComboBoxItem Content="All" IsSelected="True"/>
                <ComboBoxItem Content="Pending"/>
                <ComboBoxItem Content="Delivered"/>
            </ComboBox>

            <TextBlock Text="Category:" FontSize="13" Foreground="Black"
                       VerticalAlignment="Center" Margin="0,0,6,0"/>
            <ComboBox x:Name="CategoryFilter" Width="120" Margin="0,0,12,0"
                      SelectionChanged="Filter"
                      ItemsSource="{Binding CategoryOptions}"/>

            <TextBlock Text="Material:" FontSize="13" Foreground="Black"
                       VerticalAlignment="Center" Margin="0,0,6,0"/>
            <ComboBox x:Name="MaterialFilter" Width="120" Margin="0,0,12,0"
                      SelectionChanged="Filter"
                      ItemsSource="{Binding MaterialForSearch}"/>

            <TextBlock Text="Search:" FontSize="13" Foreground="Black"
                       VerticalAlignment="Center" Margin="0,0,6,0"/>
            <TextBox x:Name="SearchBox" Width="120" Margin="0,0,12,0"
                     TextChanged="SearchBox_TextChanged"/>

            <Button Content="Reset" Width="80"
                    Background="Gray" Foreground="White"
                    Click="ResetBtn_Click"/>
        </StackPanel>

        <!-- 3 -->
        <DataGrid Grid.Row="2" x:Name="OrdersDataGrid"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  IsReadOnly="True"
                  ItemsSource="{Binding OrdersCollection}"
                  Background="White"
                  Foreground="Black"
                  FontSize="13"
                  Margin="0,5,0,5">
            <DataGrid.ColumnHeaderStyle>
                <Style TargetType="DataGridColumnHeader">
                    <Setter Property="Background" Value="DarkGreen"/>
                    <Setter Property="Foreground" Value="White"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                    <Setter Property="Padding" Value="8,5"/>
                </Style>
            </DataGrid.ColumnHeaderStyle>
            
            <DataGrid.Columns>
                <DataGridTextColumn Header="#" Binding="{Binding OrderNumber}" Width="40"/>
                <DataGridTextColumn Header="Material" Binding="{Binding MaterialName}" Width="2*"/>
                <DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="*"/>
                <DataGridTextColumn Header="Element" Binding="{Binding elementtype}" Width="*"/>
                <DataGridTextColumn Header="Qty" Binding="{Binding Quantity}" Width="60"/>
                <DataGridTextColumn Header="Unit" Binding="{Binding Unit}" Width="60"/>
                <DataGridTextColumn Header="Unit Price" Binding="{Binding UnitPrice, StringFormat='{}{0:N0} EGP'}" Width="*"/>
                <DataGridTextColumn Header="Total" Binding="{Binding Total, StringFormat='{}{0:N0} EGP'}" Width="*"/>
                <DataGridTextColumn Header="Date" Binding="{Binding Date, StringFormat='{}{0:dd/MM/yyyy}'}" Width="*"/>
                <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="80"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- 4 -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" VerticalAlignment="Center">
            <TextBlock Text="Total Orders: " FontSize="14" FontWeight="Bold" Foreground="Black"/>
            <TextBlock x:Name="TotalOrdersText" FontSize="14" Foreground="Black" Margin="0,0,20,0"/>
            <TextBlock Text="Grand Total: " FontSize="14" FontWeight="Bold" Foreground="Black"/>
            <TextBlock x:Name="GrandTotalText" FontSize="14" Foreground="DarkGreen" FontWeight="Bold"/>
            <TextBlock Text="Pending Orders: " FontSize="14" FontWeight="Bold" Foreground="Black" Margin="20,0,0,0"/>
            <TextBlock x:Name="PendingOrdersText" FontSize="14" Foreground="DarkGreen" FontWeight="Bold"/>
        </StackPanel>

        <!-- 5 -->
        <StackPanel Grid.Row="4" Orientation="Horizontal"
                    HorizontalAlignment="Right" VerticalAlignment="Center">
            <Button Content="Export Summary" Width="130" Margin="5"
                    Click="Export_Summary"/>
            <Button Content="Mark Delivered" Width="140" Margin="5"
                    Click="MarkDelivered_Click"/>
            <Button Content="Delete Order" Width="120" Margin="5"
                    Click="DeleteOrder_Click"/>
        </StackPanel>
    </Grid>
</Window>